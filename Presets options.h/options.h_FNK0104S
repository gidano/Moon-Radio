/* ST7796 SPI display; the firmware rotates this to 480x320 landscape. */
#define DSP_MODEL DSP_FNK0104S
#define TFT_SCK   12
#define TFT_MOSI  11
#define TFT_CS    10
#define TFT_DC    46
#define TFT_RST   -1
#define BRIGHTNESS_PIN 45

/* Touch panel
   0 = nincs erintes / encoderes vagy webes hasznalat
   1 = erintopanel engedelyezve */
#define TOUCH_ENABLED 1

/* FT6336U capacitive touch controller. */
#define TS_MODEL TS_MODEL_FT6X36
#define TS_SDA 16
#define TS_SCL 15
#define TS_RST 18
#define TS_INT 17

/* FNK0104S integrated SD slot: Freenove SD_MMC 4-bit wiring. */
#define SD_MMC_ENABLED 1
#define SD_MMC_CLK 38
#define SD_MMC_CMD 40
#define SD_MMC_D0 39
#define SD_MMC_D1 41
#define SD_MMC_D2 48
#define SD_MMC_D3 47

/* PCM5102A: DIN=2, BCK=3, LCK/WS=14 (SD pins stay reserved). */
#define I2S_DOUT 2
#define I2S_BCLK 3
#define I2S_LRC  14

/* Encoder: A/S1=4, B/S2=6, push button=5. */
